# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/pipeline_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pipeline_db?retryWrites=true&w=majority

# Secret key used to sign JWT authentication tokens (use a random string in production)
JWT_SECRET=super-secret-random-key-replace-with-your-own-2026

# Local development port (optional, default is 5000)
PORT=5000
